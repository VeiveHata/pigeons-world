{
  "name": "pigeons-world",
  "description": "DoToDo: pigeons and succulents",
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "build.types": "vue-tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "tiles": "node scripts/slice-image.mjs",
    "plants": "node scripts/draw-plants.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.10.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.4.35",
    "prettier": "^3.1.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.2",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  }
}
